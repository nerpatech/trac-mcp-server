# Trac MCP Server - Environment Variables
# Copy to .env and fill in your values.

# Required: Trac instance URL
TRAC_URL=https://trac.example.com/trac

# Required: Trac credentials
TRAC_USERNAME=your-username
TRAC_PASSWORD=your-password

# Optional: Skip SSL certificate verification (default: false)
# TRAC_INSECURE=false

# Optional: Max parallel XML-RPC requests, 1-100 (default: 5)
# TRAC_MAX_PARALLEL_REQUESTS=5

# Optional: Enable debug logging (default: false)
# TRAC_DEBUG=false

# Optional: OIDC per-user auth for the http transport (shared/multi-tenant
# deployments, e.g. behind LibreChat). When set, TRAC_USERNAME/TRAC_PASSWORD
# above are not required, and every request must carry its own OIDC access
# token in the standard Authorization: Bearer <token> header instead --
# there is no shared fallback identity. Mutually exclusive with
# TRAC_MCP_AUTH_TOKEN (same header, different purpose).
# See docs/reference/http-transport.md#oidc-per-user-auth.
# TRAC_MCP_OIDC_RPC_URL=https://trac.example.com/trac-api/login/xmlrpc
# A plain http URL on a non-loopback host is refused unless you opt out:
# TRAC_MCP_OIDC_ALLOW_INSECURE_HTTP=true

# Optional: expose only tools marked read-only, on every transport; also
# hides the tools that can write a local file. true/false; anything else is
# refused at startup, empty counts as unset.
# See docs/reference/tool-architecture.md#read-only-filtering---read-only.
# TRAC_MCP_READ_ONLY=false

# Optional: comma-separated tool names to leave out, e.g. a tool that needs a
# Trac plugin the server lacks. Replaces YAML server.disabled_tools.
# See docs/reference/tool-architecture.md#disabling-individual-tools.
# TRAC_MCP_DISABLED_TOOLS=ticket_comment_history

# Required for ci-live.sh's multi-identity live test (ticket #102): a
# second real Trac account, distinct from TRAC_USERNAME/TRAC_PASSWORD
# above, used to prove two bearer identities land as two different Trac
# users. Not needed for ci.sh or normal server operation.
# TRAC_USERNAME_2=your-second-username
# TRAC_PASSWORD_2=your-second-password
