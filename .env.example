# Trac MCP Server - Environment Variables
# Copy to .env and fill in your values.

# Required: Trac instance URL
TRAC_URL=https://trac.example.com/trac

# Required: Trac credentials
TRAC_USERNAME=your-username
TRAC_PASSWORD=your-password

# Optional: Skip SSL certificate verification (default: false)
# TRAC_INSECURE=false

# Optional: Max parallel XML-RPC requests, 1-100 (default: 5)
# TRAC_MAX_PARALLEL_REQUESTS=5

# Optional: Enable debug logging (default: false)
# TRAC_DEBUG=false

# Optional: OIDC per-user auth for the http transport (shared/multi-tenant
# deployments, e.g. behind LibreChat). When set, TRAC_USERNAME/TRAC_PASSWORD
# above are not required, and every request must carry its own
# X-Trac-OIDC-Token header instead -- there is no shared fallback identity.
# See docs/reference/http-transport.md#oidc-per-user-auth.
# TRAC_MCP_OIDC_RPC_URL=https://trac.example.com/trac-api/login/xmlrpc
